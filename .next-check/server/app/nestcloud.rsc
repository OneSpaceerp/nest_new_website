$","$1","c",{"children":[["$","main",null,{"id":"main","children":[["$","$L8",null,{}],["$","section",null,{"className":"page page--story","data-bg":"cream","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"page__brand","children":["$","$L5",null,{"href":"/","className":"brand ","aria-label":"Nest Software Development — home","children":["$","$L6",null,{"src":"/company_logo/logo-01.png","alt":"Nest Software Development","width":86,"height":34,"priority":true,"unoptimized":true,"className":"brand__mark"}]}]}],"$undefined",["$","div",null,{"className":"story-hero","children":[["$","$L9",null,{"as":"header","className":"page__head","children":[["$","$L6",null,{"src":"/brands_logo/NestCloud_logo.png","alt":"Room to grow. A plan to recover.","width":220,"height":52,"className":"page__logo","priority":true}],["$","p",null,{"className":"t-eyebrow t-muted","children":"NESTCLOUD / HOSTING & OPERATIONS"}],["$","h1",null,{"className":"t-h2","children":["Room to grow. A plan to recover",["$","span",null,{"className":"accent","aria-hidden":"true","children":"."}]]}],["$","p",null,{"className":"t-lead t-muted page__intro","children":"Give your websites, applications, and business systems a cloud home with clear capacity, backup, maintenance, and support responsibilities."}],["$","div",null,{"className":"story-actions story-actions--top","children":[["$","a",null,{"href":"#enquiry","className":"btn btn-primary","children":["Plan your cloud environment"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"#story","className":"story-textlink","children":"Explore the approach ↓"}]]}]]}],["$","div",null,{"className":"story-art","children":["$","$L6",null,{"src":"/illustrations/cloud.png","alt":"Miniature server cabinets and a backup capsule connected beneath a glass cloud.","width":1536,"height":1024,"sizes":"(max-width: 760px) 100vw, 70vw","priority":true}]}]]}],[["$","section",null,{"className":"story-opening","id":"story","children":[["$","p",null,{"className":"t-eyebrow","children":"THE STARTING POINT"}],["$","div",null,{"children":[["$","h2",null,{"className":"t-h2","children":"Your application needs more than somewhere to run."}],["$","p",null,{"className":"t-lead t-muted","children":"A server can be online while an application is slow, a certificate is expiring, or a backup is failing. NestCloud starts with the workload and the business around it, then defines how the environment will be operated over time."}]]}]]}],"$undefined",["$","div",null,{"className":"story-chapters","children":[["$","$L9","Choose capacity around the workload",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"01"}],["$","h2",null,{"className":"t-h2","children":"Choose capacity around the workload"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"We consider application requirements, users, storage growth, integrations, and expected peaks. The hosting design makes resource limits, access needs, and responsibility boundaries visible from the beginning."}],["$","ul",null,{"className":"story-points","children":[["$","li","Websites, business applications, and ERP workloads",{"children":"Websites, business applications, and ERP workloads"}],["$","li","Virtual servers and scoped managed hosting",{"children":"Virtual servers and scoped managed hosting"}],["$","li","Domain, DNS, and certificate configuration",{"children":"Domain, DNS, and certificate configuration"}]]}]]}]]}],["$","$L9","Move with a rehearsed plan",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"02"}],["$","h2",null,{"className":"t-h2","children":"Move with a rehearsed plan"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Migration starts with an inventory and a restorable copy. We test the destination, agree a cutover window, and verify the application and data before retiring the old environment. A rollback route is defined before the move."}],["$","ul",null,{"className":"story-points","children":[["$","li","Dependency and data-readiness review",{"children":"Dependency and data-readiness review"}],["$","li","Staged migration and validation",{"children":"Staged migration and validation"}],["$","li","Cutover communication and rollback planning",{"children":"Cutover communication and rollback planning"}]]}]]}]]}],["$","$L9","Operate beyond launch day",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"03"}],["$","h2",null,{"className":"t-h2","children":"Operate beyond launch day"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Monitoring, updates, backups, and restore tests each need an owner. We agree recovery objectives and service coverage around the importance of the workload, then review capacity as usage changes."}],["$","ul",null,{"className":"story-points","children":[["$","li","Monitoring with incident escalation",{"children":"Monitoring with incident escalation"}],["$","li","Backup schedules, retention, and restore checks",{"children":"Backup schedules, retention, and restore checks"}],["$","li","Maintenance windows and capacity reviews",{"children":"Maintenance windows and capacity reviews"}]]}]]}]]}]]}],["$","section",null,{"className":"story-outcomes","children":[["$","p",null,{"className":"t-eyebrow","children":"WHAT THIS MAKES POSSIBLE"}],["$","h2",null,{"className":"t-h2","children":"Better work, in practical terms."}],["$","ol",null,{"children":[["$","li","A hosting environment sized for a defined workload.",{"children":"A hosting environment sized for a defined workload."}],["$","li","A migration plan your team can prepare for.",{"children":"A migration plan your team can prepare for."}],["$","li","Clear operational ownership and recovery expectations.",{"children":"Clear operational ownership and recovery expectations."}]]}]]}],["$","section",null,{"className":"story-section","aria-labelledby":"questions-heading","children":[["$","div",null,{"className":"story-section__head","children":[["$","p",null,{"className":"t-eyebrow","children":"BEFORE WE BEGIN"}],["$","h2",null,{"id":"questions-heading","className":"t-h2","children":"Good questions. Clear answers."}]]}],["$","div",null,{"className":"story-faq","children":[["$","details","Can you host our ERP and website together?",{"children":[["$","summary",null,{"children":["Can you host our ERP and website together?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"They can be managed within one service relationship, while retaining appropriate separation, resource allocation, and access controls. The architecture depends on the applications and their requirements."}]]}],["$","details","What uptime do you guarantee?",{"children":[["$","summary",null,{"children":["What uptime do you guarantee?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Availability commitments, exclusions, maintenance windows, and support response targets belong in the specific service agreement. There is no universal uptime promise across every configuration."}]]}],["$","details","Where will our data be hosted?",{"children":[["$","summary",null,{"children":["Where will our data be hosted?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"The hosting region, provider, backup locations, and access arrangements are agreed in the proposal. Tell us about residency or organisational requirements during discovery."}]]}]]}]]}],["$","div",null,{"id":"enquiry","children":["$","section",null,{"className":"story-enquiry","children":[["$","div",null,{"children":[["$","p",null,{"className":"t-eyebrow","children":"YOUR NEXT CHAPTER"}],["$","h2",null,{"className":"t-h2","children":"Start with what needs to work better."}],["$","p",null,{"children":"Tell us where things stand, what is getting in the way, and what you want to achieve. We can shape the next step from there."}]]}],["$","div",null,{"className":"story-actions","children":[["$","a",null,{"className":"btn btn-primary","href":"mailto:info@nsd-eg.com?subject=Room%20to%20grow.%20A%20plan%20to%20recover.","children":["Plan your cloud environment"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"className":"story-textlink","href":"tel:+201021965445","children":["Prefer a call? ","+2010 2196 5445"]}]]}]]}]}],["$","div",null,{"className":"story-related","children":[["$","p",null,{"className":"t-eyebrow","children":"CONNECTED THROUGH NEST"}],["$","$L5",null,{"href":"/onespace","children":"Business operations ↗"}],["$","$L5",null,{"href":"/miravoice","children":"Business communications ↗"}],["$","$L5",null,{"href":"/nestcloud","children":"Cloud & hosting ↗"}]]}]]]}]}],null]}],null,["$","$La",null,{"children":"$Lb"}]]}],{},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","dHtBHHgU_8KVwaRZvp_w6",{"children":[["$","$Lc",null,{"children":"$Ld"}],["$","$Le",null,{"children":"$Lf"}],null]}]]}],false]],"m":"$undefined","G":["$10","$undefined"],"s":false,"S":true}
