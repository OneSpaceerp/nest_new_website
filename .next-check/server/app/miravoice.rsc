$","$1","c",{"children":[["$","main",null,{"id":"main","children":[["$","$L8",null,{}],["$","section",null,{"className":"page page--story","data-bg":"cream","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"page__brand","children":["$","$L5",null,{"href":"/","className":"brand ","aria-label":"Nest Software Development — home","children":["$","$L6",null,{"src":"/company_logo/logo-01.png","alt":"Nest Software Development","width":86,"height":34,"priority":true,"unoptimized":true,"className":"brand__mark"}]}]}],"$undefined",["$","div",null,{"className":"story-hero","children":[["$","$L9",null,{"as":"header","className":"page__head","children":[["$","$L6",null,{"src":"/brands_logo/miravoice_1.png","alt":"Every call has somewhere better to go.","width":220,"height":52,"className":"page__logo","priority":true}],["$","p",null,{"className":"t-eyebrow t-muted","children":"MIRAVOICE / BUSINESS COMMUNICATIONS"}],["$","h1",null,{"className":"t-h2","children":["Every call has somewhere better to go",["$","span",null,{"className":"accent","aria-hidden":"true","children":"."}]]}],["$","p",null,{"className":"t-lead t-muted page__intro","children":"Connect callers with the right people, give teams a consistent business phone experience, and make the journey from first ring to follow-up easier to manage."}],["$","div",null,{"className":"story-actions story-actions--top","children":[["$","a",null,{"href":"#enquiry","className":"btn btn-primary","children":["Map your call journey"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"#story","className":"story-textlink","children":"Explore the approach ↓"}]]}]]}],["$","div",null,{"className":"story-art","children":["$","$L6",null,{"src":"/illustrations/voice.png","alt":"A miniature business phone and offices connected by a cyan ribbon.","width":1536,"height":1024,"sizes":"(max-width: 760px) 100vw, 70vw","priority":true}]}]]}],[["$","section",null,{"className":"story-opening","id":"story","children":[["$","p",null,{"className":"t-eyebrow","children":"THE STARTING POINT"}],["$","div",null,{"children":[["$","h2",null,{"className":"t-h2","children":"Your customer sees one business. Let them hear one too."}],["$","p",null,{"className":"t-lead t-muted","children":"A customer should not need to understand your office structure to reach the right team. MiraVoice brings extensions, routing, and call handling into a shared plan—whether colleagues work at reception, across branches, or remotely."}]]}]]}],"$undefined",["$","div",null,{"className":"story-chapters","children":[["$","$L9","Design the first thirty seconds",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"01"}],["$","h2",null,{"className":"t-h2","children":"Design the first thirty seconds"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"We map business hours, departments, language choices, and overflow routes before configuring the phone system. A concise greeting and useful menu help callers get moving without an unnecessary maze of options."}],["$","ul",null,{"className":"story-points","children":[["$","li","Business-hours and holiday routing",{"children":"Business-hours and holiday routing"}],["$","li","IVR menus and department extensions",{"children":"IVR menus and department extensions"}],["$","li","Queues, unanswered-call routes, and voicemail",{"children":"Queues, unanswered-call routes, and voicemail"}]]}]]}]]}],["$","$L9","Equip the people answering",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"02"}],["$","h2",null,{"className":"t-h2","children":"Equip the people answering"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Desk phones and compatible desktop or mobile clients can support a consistent calling experience. We assess network quality, device compatibility, and carrier requirements as part of the rollout."}],["$","ul",null,{"className":"story-points","children":[["$","li","Office and remote-user calling workflows",{"children":"Office and remote-user calling workflows"}],["$","li","Agent queues and supervisor visibility",{"children":"Agent queues and supervisor visibility"}],["$","li","Scoped CRM connections for follow-up context",{"children":"Scoped CRM connections for follow-up context"}]]}]]}]]}],["$","$L9","Make conversations accountable",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"03"}],["$","h2",null,{"className":"t-h2","children":"Make conversations accountable"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Call activity can reveal unanswered demand and busy periods. Where recording is required, the scope defines notices, permissions, storage, and retention so access is intentional and recordings do not become an unmanaged archive."}],["$","ul",null,{"className":"story-points","children":[["$","li","Agreed call reports and operational reviews",{"children":"Agreed call reports and operational reviews"}],["$","li","Recording access and retention settings",{"children":"Recording access and retention settings"}],["$","li","Testing, team training, and support handover",{"children":"Testing, team training, and support handover"}]]}]]}]]}]]}],["$","section",null,{"className":"story-outcomes","children":[["$","p",null,{"className":"t-eyebrow","children":"WHAT THIS MAKES POSSIBLE"}],["$","h2",null,{"className":"t-h2","children":"Better work, in practical terms."}],["$","ol",null,{"children":[["$","li","A clear route from incoming call to the right team.",{"children":"A clear route from incoming call to the right team."}],["$","li","Consistent business calling across supported workplaces.",{"children":"Consistent business calling across supported workplaces."}],["$","li","Useful visibility into call handling and follow-up.",{"children":"Useful visibility into call handling and follow-up."}]]}]]}],["$","section",null,{"className":"story-section","aria-labelledby":"questions-heading","children":[["$","div",null,{"className":"story-section__head","children":[["$","p",null,{"className":"t-eyebrow","children":"BEFORE WE BEGIN"}],["$","h2",null,{"id":"questions-heading","className":"t-h2","children":"Good questions. Clear answers."}]]}],["$","div",null,{"className":"story-faq","children":[["$","details","Can we keep our current numbers?",{"children":[["$","summary",null,{"children":["Can we keep our current numbers?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"We review your carrier, number ownership, and available connection or porting options. Number retention is confirmed during assessment, rather than promised before the carrier requirements are known."}]]}],["$","details","Can remote staff use MiraVoice?",{"children":[["$","summary",null,{"children":["Can remote staff use MiraVoice?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Remote calling can be configured using compatible clients and appropriate connectivity. Call quality depends on the user’s network, devices, and service configuration."}]]}],["$","details","Are recording and storage unlimited?",{"children":[["$","summary",null,{"children":["Are recording and storage unlimited?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Recording capability, storage capacity, retention periods, and access controls are defined in the chosen scope. Any required notices and lawful use remain part of the deployment review."}]]}]]}]]}],["$","div",null,{"id":"enquiry","children":["$","section",null,{"className":"story-enquiry","children":[["$","div",null,{"children":[["$","p",null,{"className":"t-eyebrow","children":"Y