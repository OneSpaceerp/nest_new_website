children":["__PAGE__",["$","$1","c",{"children":[["$","main",null,{"id":"main","children":[["$","$L8",null,{}],["$","section",null,{"className":"page page--story","data-bg":"cream","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"page__brand","children":["$","$L5",null,{"href":"/","className":"brand ","aria-label":"Nest Software Development — home","children":["$","$L6",null,{"src":"/company_logo/logo-01.png","alt":"Nest Software Development","width":86,"height":34,"priority":true,"unoptimized":true,"className":"brand__mark"}]}]}],"$undefined",["$","div",null,{"className":"story-hero","children":[["$","$L9",null,{"as":"header","className":"page__head","children":[null,["$","p",null,{"className":"t-eyebrow t-muted","children":"WEBSITES & WEB APPLICATIONS"}],["$","h1",null,{"className":"t-h2","children":["A better experience. From the first click",["$","span",null,{"className":"accent","aria-hidden":"true","children":"."}]]}],["$","p",null,{"className":"t-lead t-muted page__intro","children":"Your website starts a conversation. Your application helps someone finish a job. We design and build both around the people using them—and the business behind them."}],["$","div",null,{"className":"story-actions story-actions--top","children":[["$","a",null,{"href":"#enquiry","className":"btn btn-primary","children":["Plan your website"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"#story","className":"story-textlink","children":"Explore the approach ↓"}]]}]]}],["$","div",null,{"className":"story-art","children":["$","$L6",null,{"src":"/illustrations/digital.png","alt":"A sculptural browser, mobile phone, and content cards forming one connected journey.","width":1536,"height":1024,"sizes":"(max-width: 760px) 100vw, 70vw","priority":true}]}]]}],[["$","section",null,{"className":"story-opening","id":"story","children":[["$","p",null,{"className":"t-eyebrow","children":"THE STARTING POINT"}],["$","div",null,{"children":[["$","h2",null,{"className":"t-h2","children":"An interested visitor should know what to do next."}],["$","p",null,{"className":"t-lead t-muted","children":"A confusing menu, a slow product page, or a form that asks too much can interrupt a promising conversation. Inside a business, the same friction appears as repeated data entry and awkward workarounds. We start with the journey: what someone needs, what gets in their way, and what a successful visit looks like."}]]}]]}],"$undefined",["$","div",null,{"className":"story-chapters","children":[["$","$L9","Give the story a clear structure",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"01"}],["$","h2",null,{"className":"t-h2","children":"Give the story a clear structure"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"We turn your services, products, and expertise into an understandable route through the site. Content and interface take shape together, so the most important message has the space it needs."}],["$","ul",null,{"className":"story-points","children":[["$","li","Audience journeys, page structure, and content priorities",{"children":"Audience journeys, page structure, and content priorities"}],["$","li","Responsive layouts with accessible navigation and forms",{"children":"Responsive layouts with accessible navigation and forms"}],["$","li","Arabic and English experiences when included in the brief",{"children":"Arabic and English experiences when included in the brief"}]]}]]}]]}],["$","$L9","Make the useful parts work together",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"02"}],["$","h2",null,{"className":"t-h2","children":"Make the useful parts work together"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"A storefront, customer portal, booking experience, or internal tool becomes more valuable when the next step reaches the right system. We define what moves between your website, ERP, and other services, including what happens when a connection fails."}],["$","ul",null,{"className":"story-points","children":[["$","li","Customer portals, commerce, and business applications",{"children":"Customer portals, commerce, and business applications"}],["$","li","Scoped integrations with ownership and error handling",{"children":"Scoped integrations with ownership and error handling"}],["$","li","Content editing workflows for your own team",{"children":"Content editing workflows for your own team"}]]}]]}]]}],["$","$L9","Launch with a way to improve",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"03"}],["$","h2",null,{"className":"t-h2","children":"Launch with a way to improve"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"We test critical journeys on real screen sizes, review loading and interaction performance, and prepare redirects when replacing an existing site. After launch, agreed analytics help show where visitors succeed and where the experience needs attention."}],["$","ul",null,{"className":"story-points","children":[["$","li","Browser, mobile, accessibility, and form checks",{"children":"Browser, mobile, accessibility, and form checks"}],["$","li","Search-friendly page titles, structure, and indexability",{"children":"Search-friendly page titles, structure, and indexability"}],["$","li","Documented handover and a scoped maintenance plan",{"children":"Documented handover and a scoped maintenance plan"}]]}]]}]]}]]}],["$","section",null,{"className":"story-outcomes","children":[["$","p",null,{"className":"t-eyebrow","children":"WHAT THIS MAKES POSSIBLE"}],["$","h2",null,{"className":"t-h2","children":"Better work, in practical terms."}],["$","ol",null,{"children":[["$","li","A visitor can understand your offer and take the next step.",{"children":"A visitor can understand your offer and take the next step."}],["$","li","Your team can keep important information current.",{"children":"Your team can keep important information current."}],["$","li","Digital enquiries and orders have a defined route into operations.",{"children":"Digital enquiries and orders have a defined route into operations."}]]}]]}],["$","section",null,{"className":"story-section","aria-labelledby":"questions-heading","children":[["$","div",null,{"className":"story-section__head","children":[["$","p",null,{"className":"t-eyebrow","children":"BEFORE WE BEGIN"}],["$","h2",null,{"id":"questions-heading","className":"t-h2","children":"Good questions. Clear answers."}]]}],["$","div",null,{"className":"story-faq","children":[["$","details","Can you work with our existing design?",{"children":[["$","summary",null,{"children":["Can you work with our existing design?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Yes. We can build from an established design system, improve an existing experience, or develop the structure and visual direction together. Discovery defines what to retain and what needs rebuilding."}]]}],["$","details","Can the website connect to our ERP?",{"children":[["$","summary",null,{"children":["Can the website connect to our ERP?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"We assess the systems, available interfaces, data ownership, and required timing first. The proposal then defines the exact records and workflows to connect, along with testing and ongoing maintenance."}]]}],["$","details","Will a new website improve our search ranking?",{"children":[["$","summary",null,{"children":["Will a new website improve our search ranking?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"We can improve the technical and content foundations for discovery. Rankings also depend on competition, usefulness, authority, and ongoing work; a particular position is not guaranteed."}]]}]]}]]}],["$","div",null,{"id":"enquiry","children":["$","section",null,{"className":"story-enquiry","children":[["$","div",null,{"children":[["$","p",null,{"className":"t-eyebrow","children":"YOUR NEXT CHAPTER"}],["$","h2",null,{"className":"t-h2","children":"Start with what needs to work better."}],["$","p",null,{"children":"Tell us where things stand, what is getting in the way, and what you want to achieve. We can shape the next step from there."}]]}],["$","div",null,{"className":"story-actions","children":[["$","a",null,{"className":"btn btn-primary","href":"mailto:info@nsd-eg.com?subject=A%20better%20experience.%20From%20the%20first%20click.","children":["Plan your website"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"className":"story-textlink","href":"tel:+201021965445","children":["Prefer a call? ","+2010 2196 5445"]}]]}]]}]}],["$","div",null,{"className":"story-related","children":[["$","p",null,{"className":"t-eyebrow","children":"CONNECTED THROUGH NEST"}],["$","$L5",null,{"href":"/onespace","children":"Business operations ↗"}],["$","$L5",null,{"href":"/miravoice","children":"Business communications ↗"}],["$","$L5",null,{"href":"/nestcloud","children":"Cloud & hosting ↗"}]]}]]]}]}],null]}],null,["$","$La",null,{"children":"$Lb"}]]}],{},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","MIG04xUFSgsmB2nuDV73A",{"children":[["$","$Lc",null,{"children":"$Ld"}],["$","$Le",null,{"children":"$Lf"}],null]}]]}],false]],"m":"$undefined","G":["$10","$undefined"],"s":false,"S":true}
