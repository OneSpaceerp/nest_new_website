8:["$","main",null,{"id":"main","children":[["$","$L10",null,{}],["$","section",null,{"className":"page page--story","data-bg":"cream","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"page__brand","children":["$","$L5",null,{"href":"/","className":"brand ","aria-label":"Nest Software Development — home","children":["$","$L6",null,{"src":"/company_logo/logo-01.png","alt":"Nest Software Development","width":86,"height":34,"priority":true,"unoptimized":true,"className":"brand__mark"}]}]}],["$","$L11",null,{}],["$","div",null,{"className":"story-hero","children":[["$","$L12",null,{"as":"header","className":"page__head","children":[null,["$","p",null,{"className":"t-eyebrow t-muted","children":"ONESPACE / INTEGRATIONS & E-INVOICING"}],["$","h1",null,{"className":"t-h2","children":["Let the next system know what happened",["$","span",null,{"className":"accent","aria-hidden":"true","children":"."}]]}],["$","p",null,{"className":"t-lead t-muted page__intro","children":"Connect the moments between your ERP, sales channels, and specialist tools. Give each integration clear data ownership, useful status visibility, and a plan for exceptions."}],["$","div",null,{"className":"story-actions story-actions--top","children":[["$","a",null,{"href":"#enquiry","className":"btn btn-primary","children":["Scope your integration"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"#story","className":"story-textlink","children":"Explore the approach ↓"}]]}]]}],["$","div",null,{"className":"story-art","children":["$","$L6",null,{"src":"/illustrations/digital.png","alt":"A sculptural browser, mobile phone, and content cards forming one connected journey.","width":1536,"height":1024,"sizes":"(max-width: 760px) 100vw, 70vw","priority":true}]}]]}],[["$","section",null,{"className":"story-opening","id":"story","children":[["$","p",null,{"className":"t-eyebrow","children":"THE STARTING POINT"}],["$","div",null,{"children":[["$","h2",null,{"className":"t-h2","children":"A connection is only useful when the handover is dependable."}],["$","p",null,{"className":"t-lead t-muted","children":"An online order should reach the right team. A payment should reconcile to the right record. A rejected invoice should be visible to someone who can resolve it. We design integrations around these outcomes, including the situations where data is incomplete or a service is unavailable."}]]}]]}],[null,null],["$","div",null,{"className":"story-chapters","children":[["$","$L12","Define the source of truth",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"01"}],["$","h2",null,{"className":"t-h2","children":"Define the source of truth"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Before connecting systems, we agree which one owns customers, items, prices, stock, and transactions. Synchronisation timing, duplicate handling, permissions, and reconciliation are part of the scope."}],["$","ul",null,{"className":"story-points","children":[["$","li","Websites, commerce, payments, and specialist applications",{"children":"Websites, commerce, payments, and specialist applications"}],["$","li","Data mapping and record ownership",{"children":"Data mapping and record ownership"}],["$","li","Retries, status reporting, and exception handling",{"children":"Retries, status reporting, and exception handling"}]]}]]}]]}],["$","$L12","Prepare for Egyptian e-invoicing",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"02"}],["$","h2",null,{"className":"t-h2","children":"Prepare for Egyptian e-invoicing"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"ETA integration is a separate workstream from standard ERP setup. We assess taxpayer onboarding, credentials, electronic-signature requirements, item and tax mappings, and the applicable document flow with your finance team."}],["$","ul",null,{"className":"story-points","children":[["$","li","Readiness review and integration scope",{"children":"Readiness review and integration scope"}],["$","li","Document mapping, signing, and submission testing",{"children":"Document mapping, signing, and submission testing"}],["$","li","Acceptance or rejection tracking and reconciliation",{"children":"Acceptance or rejection tracking and reconciliation"}]]}]]}]]}],["$","$L12","Keep e-receipts and e-invoices distinct",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"03"}],["$","h2",null,{"className":"t-h2","children":"Keep e-receipts and e-invoices distinct"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Point-of-sale receipts and business invoices have different integration flows. We confirm the required scope against the applicable ETA specifications and your organisation’s requirements. Software connection alone does not establish tax compliance."}],["$","ul",null,{"className":"story-points","children":[["$","li","Separate assessment of invoice and receipt workflows",{"children":"Separate assessment of invoice and receipt workflows"}],["$","li","Test scenarios for corrections and failed submissions",{"children":"Test scenarios for corrections and failed submissions"}],["$","li","Documented operational ownership after launch",{"children":"Documented operational ownership after launch"}]]}]]}]]}],["$","$L12","Build only the missing application",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"04"}],["$","h2",null,{"className":"t-h2","children":"Build only the missing application"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Where standard ERP workflows do not fit, a focused Frappe application or integration can cover the gap. We define acceptance tests, permissions, deployment, and ongoing maintenance before development begins."}],["$","ul",null,{"className":"story-points","children":[["$","li","Custom forms, portals, and approval flows",{"children":"Custom forms, portals, and approval flows"}],["$","li","Reports tied to agreed business definitions",{"children":"Reports tied to agreed business definitions"}],["$","li","Version compatibility and upgrade planning",{"children":"Version compatibility and upgrade planning"}]]}]]}]]}]]}],["$","section",null,{"className":"story-outcomes","children":[["$","p",null,{"className":"t-eyebrow","children":"WHAT THIS MAKES POSSIBLE"}],["$","h2",null,{"className":"t-h2","children":"Better work, in practical terms."}],["$","ol",null,{"children":[["$","li","A defined handover between connected systems.",{"children":"A defined handover between connected systems."}],["$","li","Visible exceptions instead of unnoticed failures.",{"children":"Visible exceptions instead of unnoticed failures."}],["$","li","A maintainable integration with a responsible owner.",{"children":"A maintainable integration with a responsible owner."}]]}]]}],["$","section",null,{"className":"story-section","aria-labelledby":"questions-heading","children":[["$","div",null,{"className":"story-section__head","children":[["$","p",null,{"className":"t-eyebrow","children":"BEFORE WE BEGIN"}],["$","h2",null,{"id":"questions-heading","className":"t-h2","children":"Good questions. Clear answers."}]]}],["$","div",null,{"className":"story-faq","children":[["$","details","Is Egyptian e-invoicing built into every ERPNext setup?",{"children":[["$","summary",null,{"children":["Is Egyptian e-invoicing built into every ERPNext setup?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Do not assume it is. The connector, installation, onboarding, configuration, signing arrangement, testing, and ongoing maintenance must be identified in the project scope."}]]}],["$","details","Does an integration guarantee tax compliance?",{"children":[["$","summary",null,{"children":["Does an integration guarantee tax compliance?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"No. The system must be configured for your organisation and applicable requirements, and documents need correct business data. Confirm tax treatment and obligations with your finance and tax advisers."}]]}],["$","details","Can you connect an existing third-party tool?",{"children":[["$","summary",null,{"children":["Can you connect an existing third-party tool?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"We review its supported interfaces, access permissions, rate limits, and data model. This determines the available approach, implementation effort, and maintenance requirements."}]]}]]}]]}],["$","div",null,{"id":"enquiry","children":["$","section",null,{"className":"story-enquiry","children":[["$","div",null,{"children":[["$","p",null,{"className":"t-eyebrow","children":"YOUR NEXT CHAPTER"}],["$","h2",null,{"className":"t-h2","children":"Start with what needs to work better."}],["$","p",null,{"children":"Tell us where things stand, what is getting in the way, and what you want to achieve. We can shape the next step from there."}]]}],["$","div",null,{"className":"story-actions","children":[["$","a",null,{"className":"btn btn-primary","href":"mailto:info@nsd-eg.com?subject=Let%20the%20next%20system%20know%20what%20happened.","children":["Scope your integration"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"className":"story-textlink","href":"tel:+201021965445","children":["Prefer a call? ","+2010 2196 5445"]}]]}]]}]}],["$","div",null,{"className":"story-related","children":[["$","p",null,{"className":"t-eyebrow","children":"CONNECTED THROUGH NEST"}],["$","$L5",null,{"href":"/onespace","children":"Business operations ↗"}],["$","$L5",null,{"href":"/miravoice","children":"Business communications ↗"}],["$","$L5",null,{"href":"/nestcloud","children":"Cloud & hosting ↗"}]]}]]]}]}],null]}]
