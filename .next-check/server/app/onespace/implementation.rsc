8:["$","main",null,{"id":"main","children":[["$","$L10",null,{}],["$","section",null,{"className":"page page--story","data-bg":"cream","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"page__brand","children":["$","$L5",null,{"href":"/","className":"brand ","aria-label":"Nest Software Development — home","children":["$","$L6",null,{"src":"/company_logo/logo-01.png","alt":"Nest Software Development","width":86,"height":34,"priority":true,"unoptimized":true,"className":"brand__mark"}]}]}],["$","$L11",null,{}],["$","div",null,{"className":"story-hero","children":[["$","$L12",null,{"as":"header","className":"page__head","children":[null,["$","p",null,{"className":"t-eyebrow t-muted","children":"ONESPACE / IMPLEMENTATION & MIGRATION"}],["$","h1",null,{"className":"t-h2","children":["A new system. A considered transition",["$","span",null,{"className":"accent","aria-hidden":"true","children":"."}]]}],["$","p",null,{"className":"t-lead t-muted page__intro","children":"An ERP project changes how people work together. We plan the process, data, testing, and adoption as carefully as the software itself."}],["$","div",null,{"className":"story-actions story-actions--top","children":[["$","a",null,{"href":"#enquiry","className":"btn btn-primary","children":["Plan your ERP transition"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"#story","className":"story-textlink","children":"Explore the approach ↓"}]]}]]}],["$","div",null,{"className":"story-art","children":["$","$L6",null,{"src":"/illustrations/onespace.png","alt":"A miniature warehouse, ledger, and production station connected through a cyan hub.","width":1536,"height":1024,"sizes":"(max-width: 760px) 100vw, 70vw","priority":true}]}]]}],[["$","section",null,{"className":"story-opening","id":"story","children":[["$","p",null,{"className":"t-eyebrow","children":"THE STARTING POINT"}],["$","div",null,{"children":[["$","h2",null,{"className":"t-h2","children":"Go-live begins long before launch day."}],["$","p",null,{"className":"t-lead t-muted","children":"The quality of an implementation is shaped by decisions made early: what is in scope, who owns the data, how success will be tested, and who can approve a change. We make those decisions visible so the project has a shared definition of ready."}]]}]]}],[null,null],["$","div",null,{"className":"story-chapters","children":[["$","$L12","01 / Discover and agree the blueprint",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"01"}],["$","h2",null,{"className":"t-h2","children":"Discover and agree the blueprint"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Workshops follow your sales, purchasing, finance, and operational processes. We document the required workflows, reports, integrations, and responsibilities, then prioritise the first release."}],["$","ul",null,{"className":"story-points","children":[["$","li","Process map and fit-gap assessment",{"children":"Process map and fit-gap assessment"}],["$","li","Agreed scope, milestones, and acceptance criteria",{"children":"Agreed scope, milestones, and acceptance criteria"}],["$","li","Named business owners and change-control process",{"children":"Named business owners and change-control process"}]]}]]}]]}],["$","$L12","02 / Configure and prepare the data",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"02"}],["$","h2",null,{"className":"t-h2","children":"Configure and prepare the data"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"We set up the agreed workflows while your team reviews source records. Test imports reveal duplicates, missing fields, and reconciliation issues before they affect the live environment."}],["$","ul",null,{"className":"story-points","children":[["$","li","Master-data templates and cleanup responsibilities",{"children":"Master-data templates and cleanup responsibilities"}],["$","li","Trial migration and reconciliation",{"children":"Trial migration and reconciliation"}],["$","li","Configuration and custom-work demonstrations",{"children":"Configuration and custom-work demonstrations"}]]}]]}]]}],["$","$L12","03 / Rehearse the working day",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"03"}],["$","h2",null,{"className":"t-h2","children":"Rehearse the working day"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Users test complete journeys with realistic examples and exceptions. Training is organised by role, so colleagues practise the actions they will perform rather than watch a tour of every menu."}],["$","ul",null,{"className":"story-points","children":[["$","li","User acceptance tests and issue tracking",{"children":"User acceptance tests and issue tracking"}],["$","li","Role-based training and operating guides",{"children":"Role-based training and operating guides"}],["$","li","Business sign-off on balances and workflows",{"children":"Business sign-off on balances and workflows"}]]}]]}]]}],["$","$L12","04 / Cut over and stabilise",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"04"}],["$","h2",null,{"className":"t-h2","children":"Cut over and stabilise"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"The launch plan defines final data transfer, availability windows, responsibilities, and rollback conditions. After cutover, an agreed stabilisation period helps the team resolve issues and settle into the new workflow."}],["$","ul",null,{"className":"story-points","children":[["$","li","Cutover checklist and communication plan",{"children":"Cutover checklist and communication plan"}],["$","li","Post-launch verification and issue triage",{"children":"Post-launch verification and issue triage"}],["$","li","Handover to a defined support arrangement",{"children":"Handover to a defined support arrangement"}]]}]]}]]}]]}],["$","section",null,{"className":"story-outcomes","children":[["$","p",null,{"className":"t-eyebrow","children":"WHAT THIS MAKES POSSIBLE"}],["$","h2",null,{"className":"t-h2","children":"Better work, in practical terms."}],["$","ol",null,{"children":[["$","li","A shared definition of what the project will deliver.",{"children":"A shared definition of what the project will deliver."}],["$","li","Data and workflows checked before go-live.",{"children":"Data and workflows checked before go-live."}],["$","li","People prepared to use and own the new system.",{"children":"People prepared to use and own the new system."}]]}]]}],["$","section",null,{"className":"story-section","aria-labelledby":"questions-heading","children":[["$","div",null,{"className":"story-section__head","children":[["$","p",null,{"className":"t-eyebrow","children":"BEFORE WE BEGIN"}],["$","h2",null,{"id":"questions-heading","className":"t-h2","children":"Good questions. Clear answers."}]]}],["$","div",null,{"className":"story-faq","children":[["$","details","How long does implementation take?",{"children":[["$","summary",null,{"children":["How long does implementation take?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"The timeline depends on the number of entities, workflows, integrations, custom requirements, and data readiness. We provide a phased estimate after discovery rather than a universal go-live promise."}]]}],["$","details","Do we need to migrate all historical transactions?",{"children":[["$","summary",null,{"children":["Do we need to migrate all historical transactions?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Not always. We compare opening balances, selected history, and full migration against reporting needs, source quality, cost, and risk. The agreed approach includes reconciliation and access to retained records."}]]}],["$","details","What will our team need to do?",{"children":[["$","summary",null,{"children":["What will our team need to do?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Assign process owners, provide and review data, attend working sessions, test representative transactions, and approve readiness. These responsibilities are included in the project plan."}]]}]]}]]}],["$","div",null,{"id":"enquiry","children":["$","section",null,{"className":"story-enquiry","children":[["$","div",null,{"children":[["$","p",null,{"className":"t-eyebrow","children":"YOUR NEXT CHAPTER"}],["$","h2",null,{"className":"t-h2","children":"Start with what needs to work better."}],["$","p",null,{"children":"Tell us where things stand, what is getting in the way, and what you want to achieve. We can shape the next step from there."}]]}],["$","div",null,{"className":"story-actions","children":[["$","a",null,{"className":"btn btn-primary","href":"mailto:info@nsd-eg.com?subject=A%20new%20system.%20A%20considered%20transition.","children":["Plan your ERP transition"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"className":"story-textlink","href":"tel:+201021965445","children":["Prefer a call? ","+2010 2196 5445"]}]]}]]}]}],["$","div",null,{"className":"story-related","children":[["$","p",null,{"className":"t-eyebrow","children":"CONNECTED THROUGH NEST"}],["$","$L5",null,{"href":"/onespace","children":"Business operations ↗"}],["$","$L5",null,{"href":"/miravoice","children":"Business communications ↗"}],["$","$L5",null,{"href":"/nestcloud","children":"Cloud & hosting ↗"}]]}]]]}]}],null]}]
