8:["$","main",null,{"id":"main","children":[["$","$L10",null,{}],["$","section",null,{"className":"page page--story","data-bg":"cream","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"page__brand","children":["$","$L5",null,{"href":"/","className":"brand ","aria-label":"Nest Software Development — home","children":["$","$L6",null,{"src":"/company_logo/logo-01.png","alt":"Nest Software Development","width":86,"height":34,"priority":true,"unoptimized":true,"className":"brand__mark"}]}]}],["$","$L11",null,{}],["$","div",null,{"className":"story-hero","children":[["$","$L12",null,{"as":"header","className":"page__head","children":[null,["$","p",null,{"className":"t-eyebrow t-muted","children":"ONESPACE / INDUSTRIES"}],["$","h1",null,{"className":"t-h2","children":["Different businesses. Carefully connected workflows",["$","span",null,{"className":"accent","aria-hidden":"true","children":"."}]]}],["$","p",null,{"className":"t-lead t-muted page__intro","children":"A warehouse, a factory, and a project team ask different questions. Start with the work that makes your business distinctive, then connect it to a dependable financial and operational foundation."}],["$","div",null,{"className":"story-actions story-actions--top","children":[["$","a",null,{"href":"#enquiry","className":"btn btn-primary","children":["Walk us through your operation"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"#story","className":"story-textlink","children":"Explore the approach ↓"}]]}]]}],["$","div",null,{"className":"story-art","children":["$","$L6",null,{"src":"/illustrations/onespace.png","alt":"A miniature warehouse, ledger, and production station connected through a cyan hub.","width":1536,"height":1024,"sizes":"(max-width: 760px) 100vw, 70vw","priority":true}]}]]}],[["$","section",null,{"className":"story-opening","id":"story","children":[["$","p",null,{"className":"t-eyebrow","children":"THE STARTING POINT"}],["$","div",null,{"children":[["$","h2",null,{"className":"t-h2","children":"Your industry gives us a starting point. Your operation gives us the brief."}],["$","p",null,{"className":"t-lead t-muted","children":"Two companies in the same sector can have very different approval rules, pricing models, data quality, and reporting needs. We use industry workflows to make discovery concrete, then validate the details with the people who will use the system."}]]}]]}],[null,["$","section",null,{"className":"story-section","children":[["$","div",null,{"className":"story-section__head","children":[["$","p",null,{"className":"t-eyebrow","children":"FIND YOUR WORKFLOW"}],["$","h2",null,{"className":"t-h2","children":"Built around the work you do."}]]}],["$","div",null,{"className":"industry-list","children":[["$","details","Trading & distribution",{"children":[["$","summary",null,{"children":["Trading & distribution",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"An order arrives across a growing catalogue. Connect price lists, purchasing, warehouses, deliveries, and collections so commercial commitments reflect stock reality."}],["$","ul",null,{"className":"story-points","children":[["$","li","Item and unit-of-measure consistency",{"children":"Item and unit-of-measure consistency"}],["$","li","Batch, serial, and warehouse visibility",{"children":"Batch, serial, and warehouse visibility"}],["$","li","Customer credit and outstanding balances",{"children":"Customer credit and outstanding balances"}]]}],["$","$L5",null,{"className":"story-textlink","href":"/onespace/implementation","children":"See how implementation works →"}]]}],["$","details","Manufacturing",{"children":[["$","summary",null,{"children":["Manufacturing",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"A delivery promise depends on material availability and the work already in progress. Connect demand, bills of materials, production activity, and cost records."}],["$","ul",null,{"className":"story-points","children":[["$","li","Material requirements and purchase planning",{"children":"Material requirements and purchase planning"}],["$","li","Work orders, job cards, and quality checks",{"children":"Work orders, job cards, and quality checks"}],["$","li","Finished goods and production cost visibility",{"children":"Finished goods and production cost visibility"}]]}],["$","$L5",null,{"className":"story-textlink","href":"/onespace/implementation","children":"See how implementation works →"}]]}],["$","details","Retail & e-commerce",{"children":[["$","summary",null,{"children":["Retail & e-commerce",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Customers meet the same business in store and online. Define how catalogues, orders, fulfilment, returns, and payments move between the ERP and each sales channel."}],["$","ul",null,{"className":"story-points","children":[["$","li","Product and price ownership across channels",{"children":"Product and price ownership across channels"}],["$","li","Stock and order synchronisation rules",{"children":"Stock and order synchronisation rules"}],["$","li","Returns, settlement, and receipt requirements",{"children":"Returns, settlement, and receipt requirements"}]]}],["$","$L5",null,{"className":"story-textlink","href":"/onespace/implementation","children":"See how implementation works →"}]]}],["$","details","Projects & professional services",{"children":[["$","summary",null,{"children":["Projects & professional services",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Work is progressing, but the financial picture is scattered. Bring estimates, tasks, time, expenses, and billing together around a shared project record."}],["$","ul",null,{"className":"story-points","children":[["$","li","Project budgets and cost centres",{"children":"Project budgets and cost centres"}],["$","li","Task ownership and timesheets",{"children":"Task ownership and timesheets"}],["$","li","Milestone or time-based billing workflows",{"children":"Milestone or time-based billing workflows"}]]}],["$","$L5",null,{"className":"story-textlink","href":"/onespace/implementation","children":"See how implementation works →"}]]}],["$","details","Construction & contracting",{"children":[["$","summary",null,{"children":["Construction & contracting",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Each project carries its own purchasing, site costs, and payment arrangements. Start with the core financial and project records, then scope specialist contract workflows."}],["$","ul",null,{"className":"story-points","children":[["$","li","Project purchasing and material movements",{"children":"Project purchasing and material movements"}],["$","li","Cost reporting by site or project",{"children":"Cost reporting by site or project"}],["$","li","Separately scoped certificates, retention, and variations",{"children":"Separately scoped certificates, retention, and variations"}]]}],["$","$L5",null,{"className":"story-textlink","href":"/onespace/implementation","children":"See how implementation works →"}]]}],["$","details","Education & training",{"children":[["$","summary",null,{"children":["Education & training",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Administration spans enrolment, schedules, fees, and staff. Assess the fit of education applications alongside the financial system before defining the rollout."}],["$","ul",null,{"className":"story-points","children":[["$","li","Student and programme data structure",{"children":"Student and programme data structure"}],["$","li","Fee collection and financial reconciliation",{"children":"Fee collection and financial reconciliation"}],["$","li","Application fit and role-based access review",{"children":"Application fit and role-based access review"}]]}],["$","$L5",null,{"className":"story-textlink","href":"/onespace/implementation","children":"See how implementation works →"}]]}],["$","details","Healthcare operations",{"children":[["$","summary",null,{"children":["Healthcare operations",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Purchasing, stock, assets, and finance need dependable records. Clinical workflows require a separately assessed healthcare application and explicit data-access boundaries."}],["$","ul",null,{"className":"story-points","children":[["$","li","Consumables, batches, and expiry workflows",{"children":"Consumables, batches, and expiry workflows"}],["$","li","Department costs and equipment records",{"children":"Department costs and equipment records"}],["$","li","Clinical integrations and privacy requirements scoped separately",{"children":"Clinical integrations and privacy requirements scoped separately"}]]}],["$","$L5",null,{"className":"story-textlink","href":"/onespace/implementation","children":"See how implementation works →"}]]}],["$","details","Hospitality, logistics & membership businesses",{"children":[["$","summary",null,{"children":["Hospitality, logistics & membership businesses",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Reservations, shipment events, or recurring memberships may live in specialist tools. Define what stays in those systems and what should connect to finance and operations."}],["$","ul",null,{"className":"story-points","children":[["$","li","Specialist-system integration assessment",{"children":"Specialist-system integration assessment"}],["$","li","Billing, purchasing, and operational cost tracking",{"children":"Billing, purchasing, and operational cost tracking"}],["$","li","Clear ownership of customer and service records",{"children":"Clear ownership of customer and service records"}]]}],["$","$L5",null,{"className":"story-textlink","href":"/onespace/implementation","children":"See how implementation works →"}]]}]]}]]}]],["$","div",null,{"className":"story-chapters","children":[["$","$L12","Follow the work across departments",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"01"}],["$","h2",null,{"className":"t-h2","children":"Follow the work across departments"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"We walk through a representative transaction, including the exceptions. A partial delivery, returned item, changed order, or delayed payment often reveals more than a perfect demo."}],["$","ul",null,{"className":"story-points","children":[["$","li","A real transaction and its exceptions",{"children":"A real transaction and its exceptions"}],["$","li","The teams and approvals involved",{"children":"The teams and approvals involved"}],["$","li","The reports needed to manage the outcome",{"children":"The reports needed to manage the outcome"}]]}]]}]]}],["$","$L12","Separate standard fit from specialist needs",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"02"}],["$","h2",null,{"className":"t-h2","children":"Separate standard fit from specialist needs"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Finance, purchasing, and stock can provide a common foundation. Clinical records, construction certificates, reservations, and other specialist processes may require additional applications or development."}],["$","ul",null,{"className":"story-points","children":[["$","li","Core ERP requirements",{"children":"Core ERP requirements"}],["$","li","Industry application fit assessment",{"children":"Industry application fit assessment"}],["$","li","Explicit integration and customisation scope",{"children":"Explicit integration and customisation scope"}]]}]]}]]}]]}],["$","section",null,{"className":"story-outco