8:["$","main",null,{"id":"main","children":[["$","$L10",null,{}],["$","section",null,{"className":"page page--story","data-bg":"cream","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"page__brand","children":["$","$L5",null,{"href":"/","className":"brand ","aria-label":"Nest Software Development — home","children":["$","$L6",null,{"src":"/company_logo/logo-01.png","alt":"Nest Software Development","width":86,"height":34,"priority":true,"unoptimized":true,"className":"brand__mark"}]}]}],["$","$L11",null,{}],["$","div",null,{"className":"story-hero","children":[["$","$L12",null,{"as":"header","className":"page__head","children":[null,["$","p",null,{"className":"t-eyebrow t-muted","children":"ONESPACE / ERPNEXT"}],["$","h1",null,{"className":"t-h2","children":["One record. Many better decisions",["$","span",null,{"className":"accent","aria-hidden":"true","children":"."}]]}],["$","p",null,{"className":"t-lead t-muted page__intro","children":"ERPNext brings connected business records into one platform. OneSpace turns that capability into a practical operating system for your team—with the right setup, data, training, and support."}],["$","div",null,{"className":"story-actions story-actions--top","children":[["$","a",null,{"href":"#enquiry","className":"btn btn-primary","children":["Discuss ERPNext for your business"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"#story","className":"story-textlink","children":"Explore the approach ↓"}]]}]]}],["$","div",null,{"className":"story-art","children":["$","$L6",null,{"src":"/illustrations/onespace.png","alt":"A miniature warehouse, ledger, and production station connected through a cyan hub.","width":1536,"height":1024,"sizes":"(max-width: 760px) 100vw, 70vw","priority":true}]}]]}],[["$","section",null,{"className":"story-opening","id":"story","children":[["$","p",null,{"className":"t-eyebrow","children":"THE STARTING POINT"}],["$","div",null,{"children":[["$","h2",null,{"className":"t-h2","children":"The value is in the connections."}],["$","p",null,{"className":"t-lead t-muted","children":"An invoice is more useful when it connects to the customer order, the goods delivered, and the payment still due. ERPNext helps teams follow those relationships across business functions. The implementation makes sure your records, permissions, and working habits support that connected view."}]]}]]}],[["$","section",null,{"className":"story-section","children":[["$","div",null,{"className":"story-section__head","children":[["$","p",null,{"className":"t-eyebrow","children":"CONNECTED CAPABILITIES"}],["$","h2",null,{"className":"t-h2","children":"Across the working day."}]]}],["$","div",null,{"className":"module-grid","children":[["$","article","Finance & accounting",{"children":[["$","h3",null,{"className":"t-h3","children":"Finance & accounting"}],["$","p",null,{"children":"Connect invoices, payments, receivables, payables, and financial reporting. Agree the chart of accounts, cost centres, opening balances, and approval responsibilities before importing data."}]]}],["$","article","Sales & customer relationships",{"children":[["$","h3",null,{"className":"t-h3","children":"Sales & customer relationships"}],["$","p",null,{"children":"Follow an enquiry through quotation, order, delivery, and invoice. Keep customer details and commercial terms consistent across the handover to operations."}]]}],["$","article","Purchasing",{"children":[["$","h3",null,{"className":"t-h3","children":"Purchasing"}],["$","p",null,{"children":"Turn material needs into supplier enquiries, purchase orders, receipts, and invoices. Define who can request, approve, and receive each type of purchase."}]]}],["$","article","Stock & warehouses",{"children":[["$","h3",null,{"className":"t-h3","children":"Stock & warehouses"}],["$","p",null,{"children":"Track receipts, transfers, deliveries, and stock valuation across locations. Use batch or serial records where needed, supported by disciplined item data and stock reconciliation."}]]}],["$","article","Manufacturing",{"children":[["$","h3",null,{"className":"t-h3","children":"Manufacturing"}],["$","p",null,{"children":"Bring bills of materials, work orders, material movements, job cards, and quality checks into the production flow. Confirm planning assumptions with the team responsible for the shop floor."}]]}],["$","article","Projects & services",{"children":[["$","h3",null,{"className":"t-h3","children":"Projects & services"}],["$","p",null,{"children":"Organise tasks, timesheets, project costs, and billing around the work being delivered. Agree how progress and profitability will be reviewed."}]]}],["$","article","Assets & maintenance",{"children":[["$","h3",null,{"className":"t-h3","children":"Assets & maintenance"}],["$","p",null,{"children":"Maintain asset records, depreciation settings, and maintenance activities. Give finance and the people using equipment a consistent record to work from."}]]}],["$","article","People & HR",{"children":[["$","h3",null,{"className":"t-h3","children":"People & HR"}],["$","p",null,{"children":"Extend the scope with Frappe HR for employee records, leave, attendance, and payroll workflows. Local payroll rules and any attendance-device connections need their own validation."}]]}]]}]]}],null],["$","div",null,{"className":"story-chapters","children":[["$","$L12","Start with a reliable foundation",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"01"}],["$","h2",null,{"className":"t-h2","children":"Start with a reliable foundation"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Company structure, account setup, item definitions, and opening balances shape everything that follows. We agree the standards with your process owners before loading data and testing transactions."}],["$","ul",null,{"className":"story-points","children":[["$","li","Company and master-data setup",{"children":"Company and master-data setup"}],["$","li","Permissions and approval workflows",{"children":"Permissions and approval workflows"}],["$","li","Data validation and opening-balance checks",{"children":"Data validation and opening-balance checks"}]]}]]}]]}],["$","$L12","Configure first. Extend with a reason.",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"02"}],["$","h2",null,{"className":"t-h2","children":"Configure first. Extend with a reason."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Standard workflows are the starting point. Where the business needs something different, we identify the gap and assess configuration, a compatible application, or custom development. Each addition needs a purpose and an upgrade path."}],["$","ul",null,{"className":"story-points","children":[["$","li","Standard capability mapped against requirements",{"children":"Standard capability mapped against requirements"}],["$","li","Clear separation of configuration and custom work",{"children":"Clear separation of configuration and custom work"}],["$","li","Compatibility and maintenance considered early",{"children":"Compatibility and maintenance considered early"}]]}]]}]]}],["$","$L12","Expand the platform thoughtfully",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"03"}],["$","h2",null,{"className":"t-h2","children":"Expand the platform thoughtfully"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Frappe HR, CRM, Helpdesk, and other applications can support additional needs. They are distinct applications: installation, integration, version compatibility, and service costs are evaluated for your environment."}],["$","ul",null,{"className":"story-points","children":[["$","li","An agreed list of installed applications",{"children":"An agreed list of installed applications"}],["$","li","Role-based training using daily tasks",{"children":"Role-based training using daily tasks"}],["$","li","Documented reports, integrations, and ownership",{"children":"Documented reports, integrations, and ownership"}]]}]]}]]}]]}],["$","section",null,{"className":"story-outcomes","children":[["$","p",null,{"className":"t-eyebrow","children":"WHAT THIS MAKES POSSIBLE"}],["$","h2",null,{"className":"t-h2","children":"Better work, in practical terms."}],["$","ol",null,{"children":[["$","li","Trace a figure back to the transaction behind it.",{"children":"Trace a figure back to the transaction behind it."}],["$","li","Reduce repeated entry between connected workflows.",{"children":"Reduce repeated entry between connected workflows."}],["$","li","Extend your system from an understood foundation.",{"children":"Extend your system from an understood foundation."}]]}]]}],["$","section",null,{"className":"story-section","aria-labelledby":"questions-heading","children":[["$","div",null,{"className":"story-section__head","children":[["$","p",null,{"className":"t-eyebrow","children":"BEFORE WE BEGIN"}],["$","h2",null,{"id":"questions-heading","className":"t-h2","children":"Good questions. Clear answers."}]]}],["$","div",null,{"className":"story-faq","children":[["$","details","Does open source mean there are no project costs?",{"children":[["$","summary",null,{"children":["Does open source mean there are no project costs?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"No. Open source describes the software licensing model. Professional implementation, hosting, integrations, maintenance, and training remain separate cost items."}]]}],["$","details","Are all Frappe applications included?",{"children":[["$","summary",null,{"children":["Are all Frappe applications included?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"No. The installed applications and their compatibility are specified in the scope. A shared ecosystem does not mean every application is installed or connected automatically."}]]}],["$","details","Can you help compare ERPNext, Odoo, and Oracle?",{"children":[["$","summary",null,{"children":["Can you help compare ERPNext, Odoo, and Oracle?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Yes. We compare the required workflows, licensing, integration effort, hosting options, and ongoing ownership. Products and editions have different capabilities, so the comparison starts with a requirements brief."}]]}]]}]]}],["$","div",null,{"id":"enquiry","children":["$","section",null,{"className":"story-enquiry","children":[["$","div",null,{"children":[["$","p",null,{"className":"t-eyebrow","children":"YOUR NEXT CHAPTER"}],["$","h2",null,{"className":"t-h2","children":"Start with what needs to work better."}],["$","p",null,{"children":"Tell us where things stand, what is getting in the way, and what you want to achieve. We can shape the next step from there."}]]}],["$","div",null,{"className":"story-actions","children":[["$","a",null,{"className":"btn btn-primary","href":"mailto:info@nsd-eg.com?subject=One%20record.%20Many%20better%20decisions.","children":["Discuss ERPNext for your business"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"className":"story-textlink","href":"tel:+201021965445","children":["Prefer a call? ","+2010 2196 5445"]}]]}]]}]}],["$","div",null,{"className":"story-related","children":[["$","p",null,{"className":"t-eyebrow","children":"CONNECTED THROUGH NEST"}],["$","$L5",null,{"href":"/onespace","children":"Business operations ↗"}],["$","$L5",null,{"href":"/miravoice","children":"Business communications ↗"}],["$","$L5",null,{"href":"/nestcloud","children":"Cloud & hosting ↗"}]]}]]]}]}],null]}]
