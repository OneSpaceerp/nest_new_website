GE__",["$","$1","c",{"children":[["$","main",null,{"id":"main","children":[["$","$L8",null,{}],["$","section",null,{"className":"page page--story","data-bg":"cream","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"page__brand","children":["$","$L5",null,{"href":"/","className":"brand ","aria-label":"Nest Software Development — home","children":["$","$L6",null,{"src":"/company_logo/logo-01.png","alt":"Nest Software Development","width":86,"height":34,"priority":true,"unoptimized":true,"className":"brand__mark"}]}]}],"$undefined",["$","div",null,{"className":"story-hero","children":[["$","$L9",null,{"as":"header","className":"page__head","children":[null,["$","p",null,{"className":"t-eyebrow t-muted","children":"MOBILE EXPERIENCES"}],["$","h1",null,{"className":"t-h2","children":["Your next useful moment. In their pocket",["$","span",null,{"className":"accent","aria-hidden":"true","children":"."}]]}],["$","p",null,{"className":"t-lead t-muted page__intro","children":"From a customer placing an order to a colleague working in the field, build a mobile experience that makes the important task feel simple."}],["$","div",null,{"className":"story-actions story-actions--top","children":[["$","a",null,{"href":"#enquiry","className":"btn btn-primary","children":["Shape your app"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"#story","className":"story-textlink","children":"Explore the approach ↓"}]]}]]}],["$","div",null,{"className":"story-art","children":["$","$L6",null,{"src":"/illustrations/digital.png","alt":"A sculptural browser, mobile phone, and content cards forming one connected journey.","width":1536,"height":1024,"sizes":"(max-width: 760px) 100vw, 70vw","priority":true}]}]]}],[["$","section",null,{"className":"story-opening","id":"story","children":[["$","p",null,{"className":"t-eyebrow","children":"THE STARTING POINT"}],["$","div",null,{"children":[["$","h2",null,{"className":"t-h2","children":"Start with the moment an app earns its place."}],["$","p",null,{"className":"t-lead t-muted","children":"People open an app to do something: book, buy, check, approve, or complete a job. They may be using one hand, a small screen, or an unreliable connection. We shape the product around that moment, then decide which features belong in the first release."}]]}]]}],"$undefined",["$","div",null,{"className":"story-chapters","children":[["$","$L9","Find the smallest valuable release",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"01"}],["$","h2",null,{"className":"t-h2","children":"Find the smallest valuable release"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"We map the core journey and test a prototype before expanding the feature list. Native or cross-platform development is chosen around device needs, user experience, budget, and maintenance."}],["$","ul",null,{"className":"story-points","children":[["$","li","Customer, employee, and field-service journeys",{"children":"Customer, employee, and field-service journeys"}],["$","li","Clickable prototypes and clear release priorities",{"children":"Clickable prototypes and clear release priorities"}],["$","li","Device, platform, and integration decisions",{"children":"Device, platform, and integration decisions"}]]}]]}]]}],["$","$L9","Build for the world beyond the demo",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"02"}],["$","h2",null,{"className":"t-h2","children":"Build for the world beyond the demo"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Sign-in, permissions, interruptions, and failed requests all affect trust. Where offline work is needed, we define what stays available and how changes reconcile when connectivity returns."}],["$","ul",null,{"className":"story-points","children":[["$","li","Clear loading, error, and recovery states",{"children":"Clear loading, error, and recovery states"}],["$","li","Notifications tied to useful actions",{"children":"Notifications tied to useful actions"}],["$","li","Scoped camera, location, payment, and ERP connections",{"children":"Scoped camera, location, payment, and ERP connections"}]]}]]}]]}],["$","$L9","Prepare for release—and the release after it",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"03"}],["$","h2",null,{"className":"t-h2","children":"Prepare for release—and the release after it"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"We test on agreed devices, prepare store materials, and check that privacy descriptions match the app’s behaviour. Store review is controlled by Apple and Google. Post-launch monitoring and a release plan keep improvements deliberate."}],["$","ul",null,{"className":"story-points","children":[["$","li","Device testing and user acceptance",{"children":"Device testing and user acceptance"}],["$","li","Store submission preparation and review support",{"children":"Store submission preparation and review support"}],["$","li","Crash monitoring and a prioritised improvement backlog",{"children":"Crash monitoring and a prioritised improvement backlog"}]]}]]}]]}]]}],["$","section",null,{"className":"story-outcomes","children":[["$","p",null,{"className":"t-eyebrow","children":"WHAT THIS MAKES POSSIBLE"}],["$","h2",null,{"className":"t-h2","children":"Better work, in practical terms."}],["$","ol",null,{"children":[["$","li","A focused product users can learn quickly.",{"children":"A focused product users can learn quickly."}],["$","li","A defined relationship between the app and your business systems.",{"children":"A defined relationship between the app and your business systems."}],["$","li","A maintainable release plan after launch.",{"children":"A maintainable release plan after launch."}]]}]]}],["$","section",null,{"className":"story-section","aria-labelledby":"questions-heading","children":[["$","div",null,{"className":"story-section__head","children":[["$","p",null,{"className":"t-eyebrow","children":"BEFORE WE BEGIN"}],["$","h2",null,{"id":"questions-heading","className":"t-h2","children":"Good questions. Clear answers."}]]}],["$","div",null,{"className":"story-faq","children":[["$","details","Do we need separate iOS and Android apps?",{"children":[["$","summary",null,{"children":["Do we need separate iOS and Android apps?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"That depends on hardware access, performance, design requirements, and available budget. We compare native and shared-code approaches against your actual use cases before recommending a route."}]]}],["$","details","Can the app work without an internet connection?",{"children":[["$","summary",null,{"children":["Can the app work without an internet connection?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Selected workflows can be designed for offline use. We agree which data can be stored on the device, how it is protected, and how conflicting changes are handled after reconnection."}]]}],["$","details","Is store approval guaranteed?",{"children":[["$","summary",null,{"children":["Is store approval guaranteed?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"No. We prepare and test against the applicable store requirements and help resolve review feedback, but each store makes its own approval decision."}]]}]]}]]}],["$","div",null,{"id":"enquiry","children":["$","section",null,{"className":"story-enquiry","children":[["$","div",null,{"children":[["$","p",null,{"className":"t-eyebrow","children":"YOUR NEXT CHAPTER"}],["$","h2",null,{"className":"t-h2","children":"Start with what needs to work better."}],["$","p",null,{"children":"Tell us where things stand, what is getting in the way, and what you want to achieve. We can shape the next step from there."}]]}],["$","div",null,{"className":"story-actions","children":[["$","a",null,{"className":"btn btn-primary","href":"mailto:info@nsd-eg.com?subject=Your%20next%20useful%20moment.%20In%20their%20pocket.","children":["Shape your app"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"className":"story-textlink","href":"tel:+201021965445","children":["Prefer a call? ","+2010 2196 5445"]}]]}]]}]}],["$","div",null,{"className":"story-related","children":[["$","p",null,{"className":"t-eyebrow","children":"CONNECTED THROUGH NEST"}],["$","$L5",null,{"href":"/onespace","children":"Business operations ↗"}],["$","$L5",null,{"href":"/miravoice","children":"Business communications ↗"}],["$","$L5",null,{"href":"/nestcloud","children":"Cloud & hosting ↗"}]]}]]]}]}],null]}],null,["$","$La",null,{"children":"$Lb"}]]}],{},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","QAl3NAd1De7A7edpscXt9",{"children":[["$","$Lc",null,{"children":"$Ld"}],["$","$Le",null,{"children":"$Lf"}],null]}]]}],false]],"m":"$undefined","G":["$10","$undefined"],"s":false,"S":true}
