dren":["__PAGE__",["$","$1","c",{"children":[["$","main",null,{"id":"main","children":[["$","$L8",null,{}],["$","section",null,{"className":"page page--story","data-bg":"cream","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"page__brand","children":["$","$L5",null,{"href":"/","className":"brand ","aria-label":"Nest Software Development — home","children":["$","$L6",null,{"src":"/company_logo/logo-01.png","alt":"Nest Software Development","width":86,"height":34,"priority":true,"unoptimized":true,"className":"brand__mark"}]}]}],"$undefined",["$","div",null,{"className":"story-hero","children":[["$","$L9",null,{"as":"header","className":"page__head","children":[null,["$","p",null,{"className":"t-eyebrow t-muted","children":"NETWORKS & BUSINESS CONTINUITY"}],["$","h1",null,{"className":"t-h2","children":["Give everyday work a dependable foundation",["$","span",null,{"className":"accent","aria-hidden":"true","children":"."}]]}],["$","p",null,{"className":"t-lead t-muted page__intro","children":"Connect your offices, systems, and people with infrastructure designed around how work actually happens—and what the business needs when something goes wrong."}],["$","div",null,{"className":"story-actions story-actions--top","children":[["$","a",null,{"href":"#enquiry","className":"btn btn-primary","children":["Review your infrastructure"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"#story","className":"story-textlink","children":"Explore the approach ↓"}]]}]]}],["$","div",null,{"className":"story-art","children":["$","$L6",null,{"src":"/illustrations/cloud.png","alt":"Miniature server cabinets and a backup capsule connected beneath a glass cloud.","width":1536,"height":1024,"sizes":"(max-width: 760px) 100vw, 70vw","priority":true}]}]]}],[["$","section",null,{"className":"story-opening","id":"story","children":[["$","p",null,{"className":"t-eyebrow","children":"THE STARTING POINT"}],["$","div",null,{"children":[["$","h2",null,{"className":"t-h2","children":"A small interruption can travel a long way."}],["$","p",null,{"className":"t-lead t-muted","children":"When the network slows down, calls suffer, transactions wait, and teams create workarounds. We map the dependencies behind those symptoms: connectivity, equipment, access, applications, and the people responsible for each layer."}]]}]]}],"$undefined",["$","div",null,{"className":"story-chapters","children":[["$","$L9","Understand the environment",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"01"}],["$","h2",null,{"className":"t-h2","children":"Understand the environment"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"We review sites, user groups, workloads, coverage, and existing equipment. Critical services receive clear availability and recovery requirements so the design reflects business priorities."}],["$","ul",null,{"className":"story-points","children":[["$","li","Network and equipment inventory",{"children":"Network and equipment inventory"}],["$","li","Office connectivity and wireless coverage assessment",{"children":"Office connectivity and wireless coverage assessment"}],["$","li","Dependency mapping and capacity planning",{"children":"Dependency mapping and capacity planning"}]]}]]}]]}],["$","$L9","Connect with boundaries",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"02"}],["$","h2",null,{"className":"t-h2","children":"Connect with boundaries"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Staff, guests, business applications, and connected devices do not all need the same access. Network segmentation, controlled remote access, and documented permissions help make those boundaries practical."}],["$","ul",null,{"className":"story-points","children":[["$","li","Switching, routing, Wi-Fi, and firewall design",{"children":"Switching, routing, Wi-Fi, and firewall design"}],["$","li","Role-appropriate remote and administrative access",{"children":"Role-appropriate remote and administrative access"}],["$","li","Planned changes with test and rollback procedures",{"children":"Planned changes with test and rollback procedures"}]]}]]}]]}],["$","$L9","Make recovery part of the design",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"03"}],["$","h2",null,{"className":"t-h2","children":"Make recovery part of the design"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"Backups are useful when they can be restored. We define monitoring, escalation, configuration backups, and recovery checks alongside day-to-day maintenance. Response coverage and service levels are specified in the agreement."}],["$","ul",null,{"className":"story-points","children":[["$","li","Monitoring and actionable alert ownership",{"children":"Monitoring and actionable alert ownership"}],["$","li","Backup and restoration checks",{"children":"Backup and restoration checks"}],["$","li","Network documentation and maintenance schedules",{"children":"Network documentation and maintenance schedules"}]]}]]}]]}]]}],["$","section",null,{"className":"story-outcomes","children":[["$","p",null,{"className":"t-eyebrow","children":"WHAT THIS MAKES POSSIBLE"}],["$","h2",null,{"className":"t-h2","children":"Better work, in practical terms."}],["$","ol",null,{"children":[["$","li","Clear ownership of the systems your team relies on.",{"children":"Clear ownership of the systems your team relies on."}],["$","li","Access designed around business roles and boundaries.",{"children":"Access designed around business roles and boundaries."}],["$","li","A documented response when a critical service is interrupted.",{"children":"A documented response when a critical service is interrupted."}]]}]]}],["$","section",null,{"className":"story-section","aria-labelledby":"questions-heading","children":[["$","div",null,{"className":"story-section__head","children":[["$","p",null,{"className":"t-eyebrow","children":"BEFORE WE BEGIN"}],["$","h2",null,{"id":"questions-heading","className":"t-h2","children":"Good questions. Clear answers."}]]}],["$","div",null,{"className":"story-faq","children":[["$","details","Can you improve an existing network?",{"children":[["$","summary",null,{"children":["Can you improve an existing network?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Yes. An assessment identifies which components can stay, which need attention, and which changes should be prioritised. A phased plan can reduce disruption to daily work."}]]}],["$","details","How is this different from NestCloud?",{"children":[["$","summary",null,{"children":["How is this different from NestCloud?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Infrastructure covers the wider environment, including office networks, connectivity, and on-site systems. NestCloud focuses on hosting and the operation of cloud workloads. They can be scoped together."}]]}],["$","details","Is round-the-clock support included?",{"children":[["$","summary",null,{"children":["Is round-the-clock support included?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Support hours, incident priorities, escalation contacts, and response targets are agreed for the selected service. They should not be assumed from a general service description."}]]}]]}]]}],["$","div",null,{"id":"enquiry","children":["$","section",null,{"className":"story-enquiry","children":[["$","div",null,{"children":[["$","p",null,{"className":"t-eyebrow","children":"YOUR NEXT CHAPTER"}],["$","h2",null,{"className":"t-h2","children":"Start with what needs to work better."}],["$","p",null,{"children":"Tell us where things stand, what is getting in the way, and what you want to achieve. We can shape the next step from there."}]]}],["$","div",null,{"className":"story-actions","children":[["$","a",null,{"className":"btn btn-primary","href":"mailto:info@nsd-eg.com?subject=Give%20everyday%20work%20a%20dependable%20foundation.","children":["Review your infrastructure"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"className":"story-textlink","href":"tel:+201021965445","children":["Prefer a call? ","+2010 2196 5445"]}]]}]]}]}],["$","div",null,{"className":"story-related","children":[["$","p",null,{"className":"t-eyebrow","children":"CONNECTED THROUGH NEST"}],["$","$L5",null,{"href":"/onespace","children":"Business operations ↗"}],["$","$L5",null,{"href":"/miravoice","children":"Business communications ↗"}],["$","$L5",null,{"href":"/nestcloud","children":"Cloud & hosting ↗"}]]}]]]}]}],null]}],null,["$","$La",null,{"children":"$Lb"}]]}],{},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","5jBX1Uv7IxrmaMyjqevFN",{"children":[["$","$Lc",null,{"children":"$Ld"}],["$","$Le",null,{"children":"$Lf"}],null]}]]}],false]],"m":"$undefined","G":["$10","$undefined"],"s":false,"S":true}
