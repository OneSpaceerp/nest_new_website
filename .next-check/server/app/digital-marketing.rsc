}]]}],{"children":["__PAGE__",["$","$1","c",{"children":[["$","main",null,{"id":"main","children":[["$","$L8",null,{}],["$","section",null,{"className":"page page--story","data-bg":"cream","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"page__brand","children":["$","$L5",null,{"href":"/","className":"brand ","aria-label":"Nest Software Development — home","children":["$","$L6",null,{"src":"/company_logo/logo-01.png","alt":"Nest Software Development","width":86,"height":34,"priority":true,"unoptimized":true,"className":"brand__mark"}]}]}],"$undefined",["$","div",null,{"className":"story-hero","children":[["$","$L9",null,{"as":"header","className":"page__head","children":[null,["$","p",null,{"className":"t-eyebrow t-muted","children":"STRATEGY / CONTENT / CREATIVE"}],["$","h1",null,{"className":"t-h2","children":["Be understood. Then be chosen",["$","span",null,{"className":"accent","aria-hidden":"true","children":"."}]]}],["$","p",null,{"className":"t-lead t-muted page__intro","children":"Bring your positioning, content, campaigns, and website into one customer journey. Build attention around a clear offer—and measure the actions that matter to your business."}],["$","div",null,{"className":"story-actions story-actions--top","children":[["$","a",null,{"href":"#enquiry","className":"btn btn-primary","children":["Build your growth plan"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"href":"#story","className":"story-textlink","children":"Explore the approach ↓"}]]}]]}],["$","div",null,{"className":"story-art","children":["$","$L6",null,{"src":"/illustrations/digital.png","alt":"A sculptural browser, mobile phone, and content cards forming one connected journey.","width":1536,"height":1024,"sizes":"(max-width: 760px) 100vw, 70vw","priority":true}]}]]}],[["$","section",null,{"className":"story-opening","id":"story","children":[["$","p",null,{"className":"t-eyebrow","children":"THE STARTING POINT"}],["$","div",null,{"children":[["$","h2",null,{"className":"t-h2","children":"Attention is only the beginning."}],["$","p",null,{"className":"t-lead t-muted","children":"A campaign can attract the right person and still lose them on an unclear landing page. A beautiful feed can leave customers unsure what you offer. We look at the whole journey, from discovery to enquiry, and connect the message to the experience that follows it."}]]}]]}],"$undefined",["$","div",null,{"className":"story-chapters","children":[["$","$L9","Understand who needs to hear from you",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"01"}],["$","h2",null,{"className":"t-h2","children":"Understand who needs to hear from you"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"We review your offer, audience questions, existing channels, and competitors. The result is a focused message and channel plan, with an agreed definition of a useful enquiry or conversion."}],["$","ul",null,{"className":"story-points","children":[["$","li","Positioning and audience research",{"children":"Positioning and audience research"}],["$","li","Channel and content audits",{"children":"Channel and content audits"}],["$","li","Campaign objectives, budgets, and measurement plan",{"children":"Campaign objectives, budgets, and measurement plan"}]]}]]}]]}],["$","$L9","Create a recognisable presence",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"02"}],["$","h2",null,{"className":"t-h2","children":"Create a recognisable presence"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"A strong visual identity works across a product launch, a social post, and a sales presentation. We connect graphic design, motion, and copy through a consistent creative direction, with a practical approval calendar."}],["$","ul",null,{"className":"story-points","children":[["$","li","Social content and editorial planning",{"children":"Social content and editorial planning"}],["$","li","Brand graphics, campaign assets, and motion design",{"children":"Brand graphics, campaign assets, and motion design"}],["$","li","Landing pages aligned with the promise in the campaign",{"children":"Landing pages aligned with the promise in the campaign"}]]}]]}]]}],["$","$L9","Learn from meaningful signals",{"as":"section","className":"story-chapter","children":[["$","div",null,{"children":[["$","span",null,{"className":"story-index","children":"03"}],["$","h2",null,{"className":"t-h2","children":"Learn from meaningful signals"}]]}],["$","div",null,{"children":[["$","p",null,{"className":"t-lead t-muted","children":"We review qualified enquiries, conversion paths, and campaign costs alongside reach and engagement. Search work focuses on useful content and sound technical foundations. Testing helps decide what to change next; results depend on the offer, competition, budget, and execution."}],["$","ul",null,{"className":"story-points","children":[["$","li","Campaign reporting with clear metric definitions",{"children":"Campaign reporting with clear metric definitions"}],["$","li","Search content and technical SEO priorities",{"children":"Search content and technical SEO priorities"}],["$","li","Creative and landing-page experiments",{"children":"Creative and landing-page experiments"}]]}]]}]]}]]}],["$","section",null,{"className":"story-outcomes","children":[["$","p",null,{"className":"t-eyebrow","children":"WHAT THIS MAKES POSSIBLE"}],["$","h2",null,{"className":"t-h2","children":"Better work, in practical terms."}],["$","ol",null,{"children":[["$","li","A consistent message across the places customers meet you.",{"children":"A consistent message across the places customers meet you."}],["$","li","Creative work with a purpose beyond filling a calendar.",{"children":"Creative work with a purpose beyond filling a calendar."}],["$","li","A clearer view of which activity contributes to demand.",{"children":"A clearer view of which activity contributes to demand."}]]}]]}],["$","section",null,{"className":"story-section","aria-labelledby":"questions-heading","children":[["$","div",null,{"className":"story-section__head","children":[["$","p",null,{"className":"t-eyebrow","children":"BEFORE WE BEGIN"}],["$","h2",null,{"id":"questions-heading","className":"t-h2","children":"Good questions. Clear answers."}]]}],["$","div",null,{"className":"story-faq","children":[["$","details","Do you handle both content and design?",{"children":[["$","summary",null,{"children":["Do you handle both content and design?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"The scope can combine strategy, writing, graphic design, motion, and publishing support. We agree the channels, asset quantities, approval process, and responsibilities before work starts."}]]}],["$","details","Are advertising budgets included?",{"children":[["$","summary",null,{"children":["Are advertising budgets included?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"Media spend, production costs, and service fees should be itemised separately in the proposal. This makes the investment and the work being delivered easy to understand."}]]}],["$","details","Can you guarantee leads or rankings?",{"children":[["$","summary",null,{"children":["Can you guarantee leads or rankings?",["$","span",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":"No fixed volume or ranking is promised. We agree objectives and measurement, then use campaign evidence to improve the message, targeting, and conversion experience."}]]}]]}]]}],["$","div",null,{"id":"enquiry","children":["$","section",null,{"className":"story-enquiry","children":[["$","div",null,{"children":[["$","p",null,{"className":"t-eyebrow","children":"YOUR NEXT CHAPTER"}],["$","h2",null,{"className":"t-h2","children":"Start with what needs to work better."}],["$","p",null,{"children":"Tell us where things stand, what is getting in the way, and what you want to achieve. We can shape the next step from there."}]]}],["$","div",null,{"className":"story-actions","children":[["$","a",null,{"className":"btn btn-primary","href":"mailto:info@nsd-eg.com?subject=Be%20understood.%20Then%20be%20chosen.","children":["Build your growth plan"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}],["$","a",null,{"className":"story-textlink","href":"tel:+201021965445","children":["Prefer a call? ","+2010 2196 5445"]}]]}]]}]}],["$","div",null,{"className":"story-related","children":[["$","p",null,{"className":"t-eyebrow","children":"CONNECTED THROUGH NEST"}],["$","$L5",null,{"href":"/onespace","children":"Business operations ↗"}],["$","$L5",null,{"href":"/miravoice","children":"Business communications ↗"}],["$","$L5",null,{"href":"/nestcloud","children":"Cloud & hosting ↗"}]]}]]]}]}],null]}],null,["$","$La",null,{"children":"$Lb"}]]}],{},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","55jhwe_r_OXf5m6EZUAQA",{"children":[["$","$Lc",null,{"children":"$Ld"}],["$","$Le",null,{"children":"$Lf"}],null]}]]}],false]],"m":"$undefined","G":["$10","$undefined"],"s":false,"S":true}
